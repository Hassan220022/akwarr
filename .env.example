# ── Mode (set by container command; override for local dev) ──
MODE=radarr

# ── API authentication (Jellyseerr uses X-Api-Key) ──
AKWARR_API_KEY=change-me-to-a-long-random-string

# ── Akwam + Cloudflare ──
AKWAM_BASE=https://akwam.it
ELCINEMA_BASE=https://elcinema.com
ELCINEMA_ENABLE=true
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_ENABLE=true
FLARESOLVERR_AUTO=true

# ── Downloads ──
ARIA2_RPC_URL=http://akwarr-aria2:6800/jsonrpc
ARIA2_SECRET=P3TERX
BANDWIDTH_TEST_URL=https://speed.cloudflare.com/__down?bytes=25000000
BANDWIDTH_TEST_SECONDS=30
BANDWIDTH_MEASURED_BYTES_PER_SECOND=
BANDWIDTH_MEASURED_MBIT=
ARIA2_BANDWIDTH_LIMIT_PERCENT=60
ARIA2_MAX_OVERALL_DOWNLOAD_LIMIT=
PREFERRED_QUALITIES=720p,1080p,480p

# ── Storage (CT107 paths; Jellyfin CT113 reads same ZFS at /cc/Movie/Arabic and /cc/Serries/Arabic) ──
MOVIES_PATH=/media/Movie/Arabic
SERIES_PATH=/media/Serries/Arabic
STAGING_PATH=/media/Download/akwarr-staging
DATA_PATH=/config

# ── Metadata ──
TMDB_API_KEY=
METADATA_LANGUAGE=ar
SAVE_AKWAM_ARTWORK=true

# ── Jellyfin (CT113) ──
JELLYFIN_URL=http://192.168.1.20:8096
JELLYFIN_API_KEY=
JELLYFIN_MOVIES_LIBRARY_NAME=Arabic Movies
JELLYFIN_SERIES_LIBRARY_NAME=Arabic Series

# ── Worker ──
WORKER_POLL_SECONDS=10
MAX_ACTIVE_DOWNLOADS=3
RETRY_FAILED_AFTER_SECONDS=300
RETRY_TRANSIENT_AFTER_SECONDS=60
RETRY_TRANSIENT_MAX_SECONDS=600
MAX_RETRY_ATTEMPTS=5
MONITOR_MISSING_INTERVAL_SECONDS=3600
FILE_MODE=0664
DIR_MODE=0775
